<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Version>0.4.7.1</Version>
    <IsExtensionProject>true</IsExtensionProject>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Pancakes.CysTerra</AssemblyName>
    <RootNamespace>Pancakes.CysTerra</RootNamespace>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <Description>用于接收及处理 PancakesAPI来源的信息的核心组件。</Description>
    <!-- 开发者确认使用 RomanNumerals；Analyzer 标为评估 API -->
    <NoWarn>$(NoWarn);CRYVEEW5001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Cryville.EEW" Version="0.8.14" ExcludeAssets="runtime" />
    <PackageReference Include="Cryville.EEW.TagTypeKeys" Version="0.8.1" ExcludeAssets="runtime" />
    <PackageReference Include="Cryville.EEW.Analyzer" Version="0.8.7" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\LICENSE.txt" Link="LICENSE.txt" Condition="Exists('..\LICENSE.txt')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\COPYING.txt" Link="COPYING.txt" Condition="Exists('..\COPYING.txt')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
